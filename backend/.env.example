# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# --- local PostgreSQL: both variables hold the same URL ---------------------
DATABASE_URL="postgresql://postgres:root@localhost:5432/quran_circles?schema=public"
DIRECT_URL="postgresql://postgres:root@localhost:5432/quran_circles?schema=public"

# --- hosted PostgreSQL (Neon / Supabase / …) --------------------------------
# DATABASE_URL is the POOLED endpoint used by the running app.
# DIRECT_URL is the DIRECT endpoint; Prisma Migrate needs a real session and
# cannot run through a transaction pooler. On Neon the direct host is the same
# name without the "-pooler" part.
#
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=20"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=20"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=api

# Comma separated list of allowed origins for CORS / Socket.IO
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Password assigned by the seed script to every demo account
SEED_DEFAULT_PASSWORD=Pass@1234

# ---------------------------------------------------------------------------
# Uploads (school logo, avatars)
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
# Absolute base URL of this API. Image URLs are built on it, so they resolve
# from the frontend origin (the Vite dev server) as well as from the API's own.
PUBLIC_URL=http://localhost:4000

# Cloudinary — optional. Without these, uploads are stored under UPLOAD_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
