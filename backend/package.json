{
  "name": "quran-circles-backend",
  "version": "1.0.0",
  "description": "Backend for the Quran Memorization Circles Management System",
  "private": true,
  "scripts": {
    "test:full-offline": "node --test -r ts-node/register src/offline-sync/sync-all.service.test.ts",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node -P tsconfig.seed.json prisma/seed.ts",
    "bootstrap": "ts-node -P tsconfig.seed.json prisma/bootstrap.ts",
    "db:reset": "prisma migrate reset --force",
    "db:wipe": "ts-node -P tsconfig.seed.json prisma/reset.ts --force",
    "db:fresh": "prisma migrate reset --force --skip-seed && npm run bootstrap",
    "db:setup": "node scripts/db-setup.mjs",
    "test:offline-sync": "node --test -r ts-node/register src/offline-sync/offline-sync.service.test.ts",
    "test:sync-protocol": "node --test -r ts-node/register src/offline-sync/sync.service.test.ts src/offline-sync/sync.controller.test.ts",
    "test:attendance-replay": "node --test -r ts-node/register src/attendance/attendance.service.test.ts",
    "test:attendance-lock-integration": "node --test -r ts-node/register src/attendance/attendance-lock.integration.test.ts",
    "test:journal-order-integration": "node --test -r ts-node/register src/offline-sync/journal-order.integration.test.ts",
    "test:sync-push-integration": "node --test -r ts-node/register src/offline-sync/sync-push.integration.test.ts",
    "test:security": "node --test -r ts-node/register src/production-config.test.ts src/auth/jwt.strategy.test.ts src/common/validators/safe-url.test.ts src/uploads/uploads.service.test.ts",
    "test:api-integration": "node --test -r ts-node/register src/api.integration.test.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "test:backup-restore": "node scripts/backup-restore.integration.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.1.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "helmet": "^7.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.17.10",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "multer": "^2.4.0",
    "body-parser": "^1.20.6",
    "lodash": "^4.17.24",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
