// ---------------------------------------------------------------------------
// Quran Memorization Circles - Database schema
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Runtime queries. On a hosted database this is the *pooled* endpoint.
  /// On a plain local PostgreSQL both variables simply hold the same URL.
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SUPERVISOR
  TEACHER
  EXAM_COMMITTEE
  STUDENT
  SUPPORT
}

enum Gender {
  MALE
  FEMALE
}

enum Evaluation {
  EXCELLENT
  VERY_GOOD
  GOOD
  ACCEPTABLE
  UNSATISFACTORY
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  /// برنامج النشاط — مسجّل في المدرسة لكنه خارج حلقات التحفيظ
  /// (لا يقرأ بعد، صغير السن، أو يحتاج تهيئة قبل الالتحاق بحلقة).
  ACTIVITY
  GRADUATED
  WITHDRAWN
}

/// What the administration decided to do with a suspension/removal request.
/// The requester never picks this — they only supply a reason.
enum SuspensionAction {
  /// نقل إلى برنامج النشاط: يخرج من الحلقة ويبقى في السجل الموحّد.
  ACTIVITY_PROGRAM
  /// إيقاف مؤقت: يبقى في حلقته مع تحديد مدة الإيقاف.
  SUSPEND
  /// إيقاف نهائي: يخرج من الحلقة ومن المدرسة بلا مدة، ويبقى سجله كاملاً
  /// في السجل الموحّد. لا يعود إلا بقرار إداري صريح.
  PERMANENT
}

/// Courses are a separate track from the memorization circles.
enum CourseType {
  SHARIA  // دورات شرعية
  TAJWEED // أحكام التجويد
}

/// An exam milestone is either a whole juz' or a single hizb.
enum ExamSectionKind {
  JUZ
  HIZB
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  VOLUNTEER
}

enum CircleTeacherRole {
  PRIMARY
  ASSISTANT
}

/// Three practical states only: present, absent with an excuse, absent without one.
enum AttendanceStatus {
  PRESENT
  ABSENT  // غياب بدون عذر
  EXCUSED // غياب بعذر
}

enum RecitationType {
  MEMORIZATION // تسميع جديد
  MINOR_REVIEW // مراجعة صغرى
  MAJOR_REVIEW // مراجعة كبرى
  TAJWEED      // تجويد
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransferKind {
  STUDENT_TRANSFER
  TEACHER_TRANSFER
  TEACHER_SWAP
  ASSISTANT_ADD
  ASSISTANT_REMOVE
}

enum ExamRequestStatus {
  PENDING     // في قائمة الانتظار
  SCHEDULED   // تم تحديد موعد
  REJECTED
  CANCELLED
  COMPLETED
}

enum ExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  ABSENT
}

enum ExamResult {
  PASSED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationType {
  DIRECT
  GROUP
}

enum NotificationType {
  TRANSFER_REQUEST
  TRANSFER_DECISION
  SUSPENSION_REQUEST
  SUSPENSION_DECISION
  EXAM_REQUEST
  EXAM_SCHEDULED
  EXAM_RESULT
  SUPPORT_TICKET
  SUPPORT_REPLY
  CHAT_MESSAGE
  ATTENDANCE
  ANNOUNCEMENT
  PREPARATION
  COURSE
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  /// Login identity. Stored lower-cased so lookups are case-insensitive.
  /// Letters, digits or any mix of them — no forced character classes.
  username     String    @unique
  /// Optional contact address. It is no longer the login identity, so accounts
  /// can be created for staff who do not have (or do not want to give) an email.
  email        String?   @unique
  passwordHash String
  fullName     String
  role         Role
  phone        String?
  avatarUrl    String?
  /// Unified staff directory fields — filled for teachers, supervisors,
  /// administrators and exam-committee members alike.
  jobTitle       String?
  specialization String?
  isActive     Boolean   @default(true)
  /// Set when the management creates the account or resets the password, so the
  /// first login lands on the profile page until a personal password is chosen.
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  teacher  TeacherProfile?
  student  Student?

  refreshTokens        RefreshToken[]
  supervisedCircles    Circle[]              @relation("CircleSupervisor")
  notifications        Notification[]
  activityLogs         ActivityLog[]
  conversationsCreated Conversation[]        @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  messages             Message[]
  ticketsCreated       SupportTicket[]       @relation("TicketCreator")
  ticketsAssigned      SupportTicket[]       @relation("TicketAssignee")
  ticketMessages       TicketMessage[]
  attendanceRecorded   Attendance[]          @relation("AttendanceRecorder")
  transfersRequested   TransferRequest[]     @relation("TransferRequester")
  transfersDecided     TransferRequest[]     @relation("TransferDecider")
  suspensionsRequested SuspensionRequest[]   @relation("SuspensionRequester")
  suspensionsDecided   SuspensionRequest[]   @relation("SuspensionDecider")
  examRequestsReviewed ExamRequest[]         @relation("ExamRequestReviewer")
  examsGraded          Exam[]                @relation("ExamGrader")
  examsExamined        Exam[]                @relation("ExamExaminer")
  evaluationsSet       StudentEvaluation[]   @relation("EvaluationAuthor")
  studentNotes         StudentNote[]

  staffAttendance         StaffAttendance[]      @relation("StaffAttendanceSubject")
  staffAttendanceRecorded StaffAttendance[]      @relation("StaffAttendanceRecorder")
  coursesInstructed       Course[]               @relation("CourseInstructor")
  courseAttendanceTaken   CourseAttendance[]     @relation("CourseAttendanceRecorder")
  announcements           Announcement[]         @relation("AnnouncementAuthor")
  surahCompletions        SurahCompletion[]      @relation("SurahCompletionRecorder")

  @@index([role])
  @@index([isActive])
  @@index([fullName])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model TeacherProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  nationalId     String?         @unique
  birthDate      DateTime?
  gender         Gender          @default(MALE)
  address        String?
  qualification  String?
  specialization String?
  memorizedParts Int?            @default(0)
  employmentType EmploymentType  @default(VOLUNTEER)
  hireDate       DateTime?
  salary         Decimal?        @db.Decimal(10, 2)
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  circleRoles  CircleTeacher[]
  recitations  Recitation[]
  examRequests ExamRequest[]       @relation("ExamRequestTeacher")
  preparations PreparationAssignment[] @relation("PreparationTeacher")

  @@index([isActive])
  @@map("teacher_profiles")
}

// ---------------------------------------------------------------------------
// Circles
// ---------------------------------------------------------------------------

model Circle {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  description  String?
  location     String?
  level        String?
  capacity     Int       @default(25)
  scheduleDays String[]  @default([])
  startTime    String?
  endTime      String?
  supervisorId String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  supervisor  User?           @relation("CircleSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  teachers    CircleTeacher[]
  students    Student[]
  attendance  Attendance[]
  recitations Recitation[]
  memberships CircleMembership[]

  transfersFrom TransferRequest[] @relation("TransferFromCircle")
  transfersTo   TransferRequest[] @relation("TransferToCircle")

  @@index([supervisorId])
  @@index([isActive])
  @@index([name])
  @@map("circles")
}

/// Link between a circle and a teacher. `endedAt == null` means currently assigned,
/// which also preserves the full assignment history.
model CircleTeacher {
  id        String            @id @default(uuid())
  circleId  String
  teacherId String
  role      CircleTeacherRole @default(ASSISTANT)
  startedAt DateTime          @default(now())
  endedAt   DateTime?
  note      String?
  createdAt DateTime          @default(now())

  circle  Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([circleId, endedAt])
  @@index([teacherId, endedAt])
  @@map("circle_teachers")
}

// ---------------------------------------------------------------------------
// Students
// ---------------------------------------------------------------------------

model Student {
  id               String        @id @default(uuid())
  code             String        @unique
  fullName         String
  birthDate        DateTime?
  gender           Gender        @default(MALE)
  nationalId       String?       @unique
  fatherNationalId String?
  address          String?
  phone            String?
  userId           String?       @unique
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?
  circleId         String?
  enrollmentDate   DateTime      @default(now())
  status           StudentStatus @default(ACTIVE)
  evaluation       Evaluation?
  evaluationNote   String?
  evaluatedAt      DateTime?
  /// In ajza', derived from the ahzab passed — halves included, because an
  /// exam may cover an odd number of ahzab and rounding down loses real work.
  memorizedParts   Float         @default(0)
  currentSurah     String?
  currentPage      Int?
  /// The student's own picture. Students have no account, so this is set by the
  /// school or by their guardian from the parent portal.
  photoUrl         String?
  /// Running total of recitation and surah-completion points. Kept as a column
  /// rather than summed on read so student lists stay cheap to sort and page.
  totalPoints      Float         @default(0)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle  Circle? @relation(fields: [circleId], references: [id], onDelete: SetNull)

  attendance   Attendance[]
  recitations  Recitation[]
  memberships  CircleMembership[]
  suspensions  SuspensionRequest[]
  examRequests ExamRequest[]
  exams        Exam[]
  evaluations  StudentEvaluation[]
  studentNotes StudentNote[]
  transfers    TransferRequest[]  @relation("TransferStudent")

  courseEnrollments CourseEnrollment[]
  courseAttendance  CourseAttendance[]
  preparations      PreparationAssignment[]
  surahCompletions  SurahCompletion[]

  @@index([circleId])
  @@index([status])
  @@index([fullName])
  @@index([userId])
  @@map("students")
}

/// History of which circle a student belonged to and when.
model CircleMembership {
  id        String    @id @default(uuid())
  studentId String
  circleId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  reason    String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  circle  Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([studentId, endedAt])
  @@index([circleId, endedAt])
  @@map("circle_memberships")
}

/// Manual evaluation history (the teacher sets the current evaluation on the student).
model StudentEvaluation {
  id         String     @id @default(uuid())
  studentId  String
  evaluation Evaluation
  note       String?
  authorId   String
  createdAt  DateTime   @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation("EvaluationAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_evaluations")
}

model StudentNote {
  id        String    @id @default(uuid())
  studentId String
  authorId  String
  body      String
  isPrivate Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_notes")
}

// ---------------------------------------------------------------------------
// Attendance & recitation
// ---------------------------------------------------------------------------

model Attendance {
  id         String           @id @default(uuid())
  studentId  String
  circleId   String
  date       DateTime         @db.Date
  status     AttendanceStatus
  /// Free-text reason, only meaningful for EXCUSED entries.
  note       String?
  recordedById String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  circle     Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([circleId, date])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

model Recitation {
  id         String         @id @default(uuid())
  studentId  String
  circleId   String
  teacherId  String
  date       DateTime       @db.Date
  type       RecitationType @default(MEMORIZATION)
  fromSurah  String
  fromAyah   Int
  toSurah    String
  toAyah     Int
  pagesCount Float?
  /// Points scoring: one point per recited ayah, minus one per mistake and a
  /// quarter per warning. `points` is stored so a past session keeps its score
  /// even if the deduction rates are ever changed.
  versesCount Int?
  mistakes    Int    @default(0)
  warnings    Int    @default(0)
  points      Float  @default(0)
  /// Teacher's overall impression of the session. Independent of the points.
  evaluation Evaluation?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  circle  Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
  @@index([circleId, date])
  @@index([date])
  @@map("recitations")
}

// ---------------------------------------------------------------------------
// Transfers / swaps (students, teachers, assistants)
// ---------------------------------------------------------------------------

model TransferRequest {
  id           String        @id @default(uuid())
  kind         TransferKind
  status       RequestStatus @default(PENDING)
  reason       String?
  requestedById String
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  effectiveAt  DateTime?

  // student transfer
  studentId String?

  // teacher transfer / swap / assistant changes
  teacherAId String?
  teacherBId String?

  fromCircleId String?
  toCircleId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     Student? @relation("TransferStudent", fields: [studentId], references: [id], onDelete: Cascade)
  fromCircle  Circle?  @relation("TransferFromCircle", fields: [fromCircleId], references: [id], onDelete: SetNull)
  toCircle    Circle?  @relation("TransferToCircle", fields: [toCircleId], references: [id], onDelete: SetNull)
  requestedBy User     @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?    @relation("TransferDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, kind])
  @@index([studentId])
  @@index([requestedById])
  @@index([createdAt])
  @@map("transfer_requests")
}

// ---------------------------------------------------------------------------
// Suspension
// ---------------------------------------------------------------------------

/// The requester supplies a reason and nothing else. The administration reviews
/// it and picks the outcome: move to the activity programme, suspend for a set
/// number of days, or reject. Everything below `status` is therefore nullable
/// until a decision is actually made.
model SuspensionRequest {
  id            String        @id @default(uuid())
  studentId     String
  reason        String
  /// Chosen by the administration on approval, not by the requester.
  action        SuspensionAction?
  durationDays  Int?
  startDate     DateTime?     @db.Date
  endDate       DateTime?     @db.Date
  status        RequestStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  /// Set when the student is brought back before / at the end of the suspension.
  returnedAt    DateTime?
  returnedNote  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("SuspensionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?   @relation("SuspensionDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([endDate])
  @@map("suspension_requests")
}

// ---------------------------------------------------------------------------
// Examinations
// ---------------------------------------------------------------------------

/// An ordered milestone in the memorization programme (e.g. Juz' 30, Juz' 29 ...).
/// `order` defines the required progression: a student may only be examined in a
/// section once every *required* section with a lower order has been passed.
model ExamSection {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  order       Int      @unique
  kind        ExamSectionKind @default(JUZ)
  isRequired  Boolean  @default(true)
  pagesCount  Int?
  minScore    Int      @default(60)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  examRequests ExamRequest[]
  exams        Exam[]
  onRequests   ExamRequestSection[]
  onExams      ExamSectionOnExam[]

  @@index([order])
  @@index([kind])
  @@map("exam_sections")
}

/// An exam may cover several juz'/ahzab at once. `ExamRequest.sectionId` stays
/// as the lowest-ordered section of the set — it drives the progression rules
/// and keeps every existing query working — while this table holds the full list.
model ExamRequestSection {
  id        String @id @default(uuid())
  requestId String
  sectionId String

  request ExamRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([requestId, sectionId])
  @@index([sectionId])
  @@map("exam_request_sections")
}

model ExamSectionOnExam {
  id        String @id @default(uuid())
  examId    String
  sectionId String

  exam    Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([examId, sectionId])
  @@index([sectionId])
  @@map("exam_sections_on_exams")
}

model ExamRequest {
  id         String            @id @default(uuid())
  studentId  String
  sectionId  String
  teacherId  String
  status     ExamRequestStatus @default(PENDING)
  note       String?
  requestedHizb     Int?
  requestedJuz      Int?
  requestedCombined Int?
  reviewedById String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section    ExamSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher    TeacherProfile @relation("ExamRequestTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("ExamRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  exam       Exam?
  sections   ExamRequestSection[]

  @@index([status, createdAt])
  @@index([studentId])
  @@map("exam_requests")
}

model Exam {
  id          String      @id @default(uuid())
  requestId   String?     @unique
  studentId   String
  sectionId   String
  examinerId  String?
  scheduledAt DateTime
  location    String?
  status      ExamStatus  @default(SCHEDULED)
  /// Grade out of 100; compared against the section's `minScore` to decide the result.
  score       Int?
  /// Derived from `score` by the school's grading scale — never chosen by hand.
  /// Stored rather than computed on read so an official result cannot change
  /// retroactively if the scale is ever adjusted.
  evaluation  Evaluation?
  /// Optional — the examiner may record a score and notes without counting mistakes.
  mistakes    Int?
  result      ExamResult?
  notes       String?
  gradedById  String?
  gradedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  request  ExamRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  ExamSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  examiner User?        @relation("ExamExaminer", fields: [examinerId], references: [id], onDelete: SetNull)
  gradedBy User?        @relation("ExamGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  sections ExamSectionOnExam[]

  @@index([studentId, status])
  @@index([scheduledAt])
  @@index([status])
  @@map("exams")
}

// ---------------------------------------------------------------------------
// Technical support
// ---------------------------------------------------------------------------
