// ---------------------------------------------------------------------------
// Quran Memorization Circles - Database schema
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Runtime queries. On a hosted database this is the *pooled* endpoint.
  url      = env("DATABASE_URL")
  /// Migrations and introspection. Prisma Migrate needs a real session
  /// (advisory locks, DDL) which a transaction pooler such as PgBouncer cannot
  /// give it, so it gets the *direct* endpoint instead. On a plain local
  /// PostgreSQL both variables simply hold the same URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SUPERVISOR
  TEACHER
  EXAM_COMMITTEE
  PARENT
  SUPPORT
}

enum Gender {
  MALE
  FEMALE
}

enum Evaluation {
  EXCELLENT
  VERY_GOOD
  GOOD
  ACCEPTABLE
  UNSATISFACTORY
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  /// برنامج النشاط — مسجّل في المدرسة لكنه خارج حلقات التحفيظ
  /// (لا يقرأ بعد، صغير السن، أو يحتاج تهيئة قبل الالتحاق بحلقة).
  ACTIVITY
  GRADUATED
  WITHDRAWN
}

/// What the administration decided to do with a suspension/removal request.
/// The requester never picks this — they only supply a reason.
enum SuspensionAction {
  /// نقل إلى برنامج النشاط: يخرج من الحلقة ويبقى في السجل الموحّد.
  ACTIVITY_PROGRAM
  /// إيقاف مؤقت: يبقى في حلقته مع تحديد مدة الإيقاف.
  SUSPEND
  /// إيقاف نهائي: يخرج من الحلقة ومن المدرسة بلا مدة، ويبقى سجله كاملاً
  /// في السجل الموحّد. لا يعود إلا بقرار إداري صريح.
  PERMANENT
}

/// Courses are a separate track from the memorization circles.
enum CourseType {
  SHARIA  // دورات شرعية
  TAJWEED // أحكام التجويد
}

/// An exam milestone is either a whole juz' or a single hizb.
enum ExamSectionKind {
  JUZ
  HIZB
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  VOLUNTEER
}

enum CircleTeacherRole {
  PRIMARY
  ASSISTANT
}

/// Three practical states only: present, absent with an excuse, absent without one.
enum AttendanceStatus {
  PRESENT
  ABSENT  // غياب بدون عذر
  EXCUSED // غياب بعذر
}

enum RecitationType {
  MEMORIZATION // تسميع جديد
  MINOR_REVIEW // مراجعة صغرى
  MAJOR_REVIEW // مراجعة كبرى
  TAJWEED      // تجويد
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransferKind {
  STUDENT_TRANSFER
  TEACHER_TRANSFER
  TEACHER_SWAP
  ASSISTANT_ADD
  ASSISTANT_REMOVE
}

enum ExamRequestStatus {
  PENDING     // في قائمة الانتظار
  SCHEDULED   // تم تحديد موعد
  REJECTED
  CANCELLED
  COMPLETED
}

enum ExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  ABSENT
}

enum ExamResult {
  PASSED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationType {
  DIRECT
  GROUP
}

enum NotificationType {
  TRANSFER_REQUEST
  TRANSFER_DECISION
  SUSPENSION_REQUEST
  SUSPENSION_DECISION
  EXAM_REQUEST
  EXAM_SCHEDULED
  EXAM_RESULT
  SUPPORT_TICKET
  SUPPORT_REPLY
  CHAT_MESSAGE
  ATTENDANCE
  ANNOUNCEMENT
  PREPARATION
  COURSE
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  /// Login identity. Stored lower-cased so lookups are case-insensitive.
  /// Letters, digits or any mix of them — no forced character classes.
  username     String    @unique
  /// Optional contact address. It is no longer the login identity, so accounts
  /// can be created for staff who do not have (or do not want to give) an email.
  email        String?   @unique
  passwordHash String
  fullName     String
  role         Role
  phone        String?
  avatarUrl    String?
  /// Unified staff directory fields — filled for teachers, supervisors,
  /// administrators and exam-committee members alike.
  jobTitle       String?
  specialization String?
  isActive     Boolean   @default(true)
  /// Set when the management creates the account or resets the password, so the
  /// first login lands on the profile page until a personal password is chosen.
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  teacher  TeacherProfile?
  parent   ParentProfile?

  refreshTokens        RefreshToken[]
  supervisedCircles    Circle[]              @relation("CircleSupervisor")
  notifications        Notification[]
  activityLogs         ActivityLog[]
  conversationsCreated Conversation[]        @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  messages             Message[]
  ticketsCreated       SupportTicket[]       @relation("TicketCreator")
  ticketsAssigned      SupportTicket[]       @relation("TicketAssignee")
  ticketMessages       TicketMessage[]
  attendanceRecorded   Attendance[]          @relation("AttendanceRecorder")
  transfersRequested   TransferRequest[]     @relation("TransferRequester")
  transfersDecided     TransferRequest[]     @relation("TransferDecider")
  suspensionsRequested SuspensionRequest[]   @relation("SuspensionRequester")
  suspensionsDecided   SuspensionRequest[]   @relation("SuspensionDecider")
  examRequestsReviewed ExamRequest[]         @relation("ExamRequestReviewer")
  examsGraded          Exam[]                @relation("ExamGrader")
  examsExamined        Exam[]                @relation("ExamExaminer")
  evaluationsSet       StudentEvaluation[]   @relation("EvaluationAuthor")
  studentNotes         StudentNote[]

  staffAttendance         StaffAttendance[]      @relation("StaffAttendanceSubject")
  staffAttendanceRecorded StaffAttendance[]      @relation("StaffAttendanceRecorder")
  coursesInstructed       Course[]               @relation("CourseInstructor")
  courseAttendanceTaken   CourseAttendance[]     @relation("CourseAttendanceRecorder")
  announcements           Announcement[]         @relation("AnnouncementAuthor")
  surahCompletions        SurahCompletion[]      @relation("SurahCompletionRecorder")

  @@index([role])
  @@index([isActive])
  @@index([fullName])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model TeacherProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  nationalId     String?         @unique
  birthDate      DateTime?
  gender         Gender          @default(MALE)
  address        String?
  qualification  String?
  specialization String?
  memorizedParts Int?            @default(0)
  employmentType EmploymentType  @default(VOLUNTEER)
  hireDate       DateTime?
  salary         Decimal?        @db.Decimal(10, 2)
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  circleRoles  CircleTeacher[]
  recitations  Recitation[]
  examRequests ExamRequest[]       @relation("ExamRequestTeacher")
  preparations PreparationAssignment[] @relation("PreparationTeacher")

  @@index([isActive])
  @@map("teacher_profiles")
}

model ParentProfile {
  id         String    @id @default(uuid())
  userId     String    @unique
  nationalId String?   @unique
  phone      String?
  altPhone   String?
  address    String?
  occupation String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]

  @@map("parent_profiles")
}

// ---------------------------------------------------------------------------
// Circles
// ---------------------------------------------------------------------------

model Circle {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  description  String?
  location     String?
  level        String?
  capacity     Int       @default(25)
  scheduleDays String[]  @default([])
  startTime    String?
  endTime      String?
  supervisorId String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  supervisor  User?           @relation("CircleSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  teachers    CircleTeacher[]
  students    Student[]
  attendance  Attendance[]
  recitations Recitation[]
  memberships CircleMembership[]

  transfersFrom TransferRequest[] @relation("TransferFromCircle")
  transfersTo   TransferRequest[] @relation("TransferToCircle")

  @@index([supervisorId])
  @@index([isActive])
  @@index([name])
  @@map("circles")
}

/// Link between a circle and a teacher. `endedAt == null` means currently assigned,
/// which also preserves the full assignment history.
model CircleTeacher {
  id        String            @id @default(uuid())
  circleId  String
  teacherId String
  role      CircleTeacherRole @default(ASSISTANT)
  startedAt DateTime          @default(now())
  endedAt   DateTime?
  note      String?
  createdAt DateTime          @default(now())

  circle  Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([circleId, endedAt])
  @@index([teacherId, endedAt])
  @@map("circle_teachers")
}

// ---------------------------------------------------------------------------
// Students
// ---------------------------------------------------------------------------

model Student {
  id               String        @id @default(uuid())
  code             String        @unique
  fullName         String
  birthDate        DateTime?
  gender           Gender        @default(MALE)
  nationalId       String?       @unique
  fatherNationalId String?
  address          String?
  phone            String?
  parentId         String?
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?
  circleId         String?
  enrollmentDate   DateTime      @default(now())
  status           StudentStatus @default(ACTIVE)
  evaluation       Evaluation?
  evaluationNote   String?
  evaluatedAt      DateTime?
  /// In ajza', derived from the ahzab passed — halves included, because an
  /// exam may cover an odd number of ahzab and rounding down loses real work.
  memorizedParts   Float         @default(0)
  currentSurah     String?
  currentPage      Int?
  /// The student's own picture. Students have no account, so this is set by the
  /// school or by their guardian from the parent portal.
  photoUrl         String?
  /// Running total of recitation and surah-completion points. Kept as a column
  /// rather than summed on read so student lists stay cheap to sort and page.
  totalPoints      Float         @default(0)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  parentProfile ParentProfile? @relation(fields: [parentId], references: [id], onDelete: SetNull)
  circle        Circle?        @relation(fields: [circleId], references: [id], onDelete: SetNull)

  attendance   Attendance[]
  recitations  Recitation[]
  memberships  CircleMembership[]
  suspensions  SuspensionRequest[]
  examRequests ExamRequest[]
  exams        Exam[]
  evaluations  StudentEvaluation[]
  studentNotes StudentNote[]
  transfers    TransferRequest[]  @relation("TransferStudent")

  courseEnrollments CourseEnrollment[]
  courseAttendance  CourseAttendance[]
  preparations      PreparationAssignment[]
  surahCompletions  SurahCompletion[]

  @@index([circleId])
  @@index([parentId])
  @@index([status])
  @@index([fullName])
  @@map("students")
}

/// History of which circle a student belonged to and when.
model CircleMembership {
  id        String    @id @default(uuid())
  studentId String
  circleId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  reason    String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  circle  Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([studentId, endedAt])
  @@index([circleId, endedAt])
  @@map("circle_memberships")
}

/// Manual evaluation history (the teacher sets the current evaluation on the student).
model StudentEvaluation {
  id         String     @id @default(uuid())
  studentId  String
  evaluation Evaluation
  note       String?
  authorId   String
  createdAt  DateTime   @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation("EvaluationAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_evaluations")
}

model StudentNote {
  id        String    @id @default(uuid())
  studentId String
  authorId  String
  body      String
  isPrivate Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_notes")
}

// ---------------------------------------------------------------------------
// Attendance & recitation
// ---------------------------------------------------------------------------

model Attendance {
  id         String           @id @default(uuid())
  studentId  String
  circleId   String
  date       DateTime         @db.Date
  status     AttendanceStatus
  /// Free-text reason, only meaningful for EXCUSED entries.
  note       String?
  recordedById String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  circle     Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([circleId, date])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

model Recitation {
  id         String         @id @default(uuid())
  studentId  String
  circleId   String
  teacherId  String
  date       DateTime       @db.Date
  type       RecitationType @default(MEMORIZATION)
  fromSurah  String
  fromAyah   Int
  toSurah    String
  toAyah     Int
  pagesCount Float?
  /// Points scoring: one point per recited ayah, minus one per mistake and a
  /// quarter per warning. `points` is stored so a past session keeps its score
  /// even if the deduction rates are ever changed.
  versesCount Int?
  mistakes    Int    @default(0)
  warnings    Int    @default(0)
  points      Float  @default(0)
  /// Teacher's overall impression of the session. Independent of the points.
  evaluation Evaluation?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  circle  Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
  @@index([circleId, date])
  @@index([date])
  @@map("recitations")
}

// ---------------------------------------------------------------------------
// Transfers / swaps (students, teachers, assistants)
// ---------------------------------------------------------------------------

model TransferRequest {
  id           String        @id @default(uuid())
  kind         TransferKind
  status       RequestStatus @default(PENDING)
  reason       String?
  requestedById String
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  effectiveAt  DateTime?

  // student transfer
  studentId String?

  // teacher transfer / swap / assistant changes
  teacherAId String?
  teacherBId String?

  fromCircleId String?
  toCircleId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     Student? @relation("TransferStudent", fields: [studentId], references: [id], onDelete: Cascade)
  fromCircle  Circle?  @relation("TransferFromCircle", fields: [fromCircleId], references: [id], onDelete: SetNull)
  toCircle    Circle?  @relation("TransferToCircle", fields: [toCircleId], references: [id], onDelete: SetNull)
  requestedBy User     @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?    @relation("TransferDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, kind])
  @@index([studentId])
  @@index([requestedById])
  @@index([createdAt])
  @@map("transfer_requests")
}

// ---------------------------------------------------------------------------
// Suspension
// ---------------------------------------------------------------------------

/// The requester supplies a reason and nothing else. The administration reviews
/// it and picks the outcome: move to the activity programme, suspend for a set
/// number of days, or reject. Everything below `status` is therefore nullable
/// until a decision is actually made.
model SuspensionRequest {
  id            String        @id @default(uuid())
  studentId     String
  reason        String
  /// Chosen by the administration on approval, not by the requester.
  action        SuspensionAction?
  durationDays  Int?
  startDate     DateTime?     @db.Date
  endDate       DateTime?     @db.Date
  status        RequestStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  /// Set when the student is brought back before / at the end of the suspension.
  returnedAt    DateTime?
  returnedNote  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("SuspensionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?   @relation("SuspensionDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
  @@index([endDate])
  @@map("suspension_requests")
}

// ---------------------------------------------------------------------------
// Examinations
// ---------------------------------------------------------------------------

/// An ordered milestone in the memorization programme (e.g. Juz' 30, Juz' 29 ...).
/// `order` defines the required progression: a student may only be examined in a
/// section once every *required* section with a lower order has been passed.
model ExamSection {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  order       Int      @unique
  kind        ExamSectionKind @default(JUZ)
  isRequired  Boolean  @default(true)
  pagesCount  Int?
  minScore    Int      @default(60)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  examRequests ExamRequest[]
  exams        Exam[]
  onRequests   ExamRequestSection[]
  onExams      ExamSectionOnExam[]

  @@index([order])
  @@index([kind])
  @@map("exam_sections")
}

/// An exam may cover several juz'/ahzab at once. `ExamRequest.sectionId` stays
/// as the lowest-ordered section of the set — it drives the progression rules
/// and keeps every existing query working — while this table holds the full list.
model ExamRequestSection {
  id        String @id @default(uuid())
  requestId String
  sectionId String

  request ExamRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([requestId, sectionId])
  @@index([sectionId])
  @@map("exam_request_sections")
}

model ExamSectionOnExam {
  id        String @id @default(uuid())
  examId    String
  sectionId String

  exam    Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([examId, sectionId])
  @@index([sectionId])
  @@map("exam_sections_on_exams")
}

model ExamRequest {
  id         String            @id @default(uuid())
  studentId  String
  sectionId  String
  teacherId  String
  status     ExamRequestStatus @default(PENDING)
  note       String?
  requestedHizb     Int?
  requestedJuz      Int?
  requestedCombined Int?
  reviewedById String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section    ExamSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher    TeacherProfile @relation("ExamRequestTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("ExamRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  exam       Exam?
  sections   ExamRequestSection[]

  @@index([status, createdAt])
  @@index([studentId])
  @@map("exam_requests")
}

model Exam {
  id          String      @id @default(uuid())
  requestId   String?     @unique
  studentId   String
  sectionId   String
  examinerId  String?
  scheduledAt DateTime
  location    String?
  status      ExamStatus  @default(SCHEDULED)
  /// Grade out of 100; compared against the section's `minScore` to decide the result.
  score       Int?
  /// Derived from `score` by the school's grading scale — never chosen by hand.
  /// Stored rather than computed on read so an official result cannot change
  /// retroactively if the scale is ever adjusted.
  evaluation  Evaluation?
  /// Optional — the examiner may record a score and notes without counting mistakes.
  mistakes    Int?
  result      ExamResult?
  notes       String?
  gradedById  String?
  gradedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  request  ExamRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  ExamSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  examiner User?        @relation("ExamExaminer", fields: [examinerId], references: [id], onDelete: SetNull)
  gradedBy User?        @relation("ExamGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  sections ExamSectionOnExam[]

  @@index([studentId, status])
  @@index([scheduledAt])
  @@index([status])
  @@map("exams")
}

// ---------------------------------------------------------------------------
// Technical support
// ---------------------------------------------------------------------------

model SupportTicket {
  id          String         @id @default(uuid())
  number      Int            @unique @default(autoincrement())
  subject     String
  category    String?
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  /// Null for tickets raised from the login page by someone who cannot sign in.
  createdById String?
  /// Contact details for those unauthenticated tickets — otherwise there would
  /// be no way to reply to a user who is locked out.
  contactName  String?
  contactPhone String?
  contactEmail String?
  assignedToId String?
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  createdBy  User?           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   TicketMessage[]

  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@map("support_tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  senderId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType @default(DIRECT)
  title       String?
  description String?
  avatarUrl   String?
  createdById String?
  lastMessageAt DateTime?
  /// Group is archived: history stays readable but no new messages are accepted.
  isClosed    Boolean          @default(false)
  /// Only group admins may post; everyone else has read-only access.
  adminOnly   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  isAdmin        Boolean   @default(false)
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  /// Set the first time the sender edits the message, so the UI can mark it.
  editedAt       DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Settings & activity
// ---------------------------------------------------------------------------

model SchoolSettings {
  id           String   @id @default("default")
  name         String   @default("حلقات تحفيظ القرآن الكريم")
  mosqueName   String?
  logoUrl      String?
  phone        String?
  email        String?
  address      String?
  about        String?
  facebook     String?
  twitter      String?
  instagram    String?
  youtube      String?
  telegram     String?
  whatsapp     String?
  website      String?
  academicYear String?
  updatedAt    DateTime @updatedAt

  @@map("school_settings")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Educational courses
//
// A completely separate track from the memorization circles: its own circles
// ("course circles"), its own enrolments and its own attendance register. A
// student may be enrolled in courses, in a circle, in both, or in neither
// (the activity programme) — they are always the same Student record, which is
// what makes the unified student profile possible.
// ---------------------------------------------------------------------------

model Course {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  type         CourseType
  description  String?
  /// Free-text lecturer name, kept for courses given by someone who has no
  /// account in the system; `instructorId` is used when they do.
  instructorName String?
  instructorId String?
  location     String?
  startDate    DateTime?  @db.Date
  endDate      DateTime?  @db.Date
  scheduleDays String[]   @default([])
  startTime    String?
  endTime      String?
  capacity     Int        @default(30)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  instructor  User?              @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  enrollments CourseEnrollment[]
  attendance  CourseAttendance[]

  @@index([type])
  @@index([isActive])
  @@index([instructorId])
  @@map("courses")
}

model CourseEnrollment {
  id         String    @id @default(uuid())
  courseId   String
  studentId  String
  enrolledAt DateTime  @default(now())
  /// Set when the student leaves the course; keeps the history of past courses.
  endedAt    DateTime?
  note       String?

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, endedAt])
  @@map("course_enrollments")
}

/// Independent of `attendance` — a course register never mixes with a circle one.
model CourseAttendance {
  id           String           @id @default(uuid())
  courseId     String
  studentId    String
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("CourseAttendanceRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, date])
  @@index([courseId, date])
  @@index([studentId, date])
  @@map("course_attendance")
}

// ---------------------------------------------------------------------------
// Staff
// ---------------------------------------------------------------------------

/// Attendance for the educational and administrative staff, mirroring the
/// student register but keyed on the user account rather than a student.
model StaffAttendance {
  id           String           @id @default(uuid())
  userId       String
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User @relation("StaffAttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User @relation("StaffAttendanceRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
  @@map("staff_attendance")
}

// ---------------------------------------------------------------------------
// Preparation assignments & points
// ---------------------------------------------------------------------------

/// "Prepare Al-Baqarah 1-20 for the next session." Visible to the student's
/// guardian, who is notified when it is created.
model PreparationAssignment {
  id        String    @id @default(uuid())
  studentId String
  teacherId String
  fromSurah String
  fromAyah  Int
  toSurah   String
  toAyah    Int
  note      String?
  dueDate   DateTime? @db.Date
  completedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation("PreparationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@map("preparation_assignments")
}

/// Bonus points awarded when a student finishes memorizing a whole surah.
model SurahCompletion {
  id           String   @id @default(uuid())
  studentId    String
  surah        String
  points       Float    @default(0)
  note         String?
  completedAt  DateTime @default(now())
  recordedById String

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("SurahCompletionRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@unique([studentId, surah])
  @@index([studentId, completedAt])
  @@map("surah_completions")
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

/// Published by the administration only. `audience` empty means "everyone";
/// otherwise the announcement is shown to the listed roles.
model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String?
  /// In-app path the announcement bar links to, e.g. "/courses".
  link        String?
  audience    Role[]    @default([])
  isActive    Boolean   @default(true)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User? @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, publishedAt])
  @@map("announcements")
}
