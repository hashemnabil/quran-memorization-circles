# Development uses the Vite proxy, so these can stay empty.
# Set them only when the frontend is served from a different origin than the API.

# Base URL of the REST API (default: /api via the dev proxy)
# VITE_API_URL=http://localhost:3000/api

# Origin of the Socket.IO server (default: same origin as the page)
# VITE_SOCKET_URL=http://localhost:3000

# Backend the dev-server proxy forwards to (default: http://127.0.0.1:3000)
# Must match PORT in backend/.env
# VITE_PROXY_TARGET=http://127.0.0.1:3000
