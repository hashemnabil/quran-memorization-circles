# Web development uses the Vite proxy, so leave these empty for local browser development.
# For a mobile build, set both to the reachable origin of the EXISTING NestJS backend.
# Example on a local network: http://192.168.1.20:3000 (use your computer's LAN IP, not localhost).
# Production should use your existing HTTPS API domain.
VITE_API_URL=
VITE_SOCKET_URL=

# Base URL of the REST API (default: /api via the browser dev proxy)
# VITE_API_URL=https://your-existing-api.example.com/api

# Origin of the existing Socket.IO server (default: same origin as browser page)
# VITE_SOCKET_URL=https://your-existing-api.example.com

# Backend the dev-server proxy forwards to (default: http://127.0.0.1:3000)
# Must match PORT in backend/.env
# VITE_PROXY_TARGET=http://127.0.0.1:3000
