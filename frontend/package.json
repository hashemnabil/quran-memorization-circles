{
  "name": "quran-circles-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:prayer": "node --import tsx --test src/lib/prayer-times.test.ts src/lib/notification-audio.test.mjs",
    "test:e2e:prayer": "playwright test --config playwright.prayer.config.ts",
    "test:e2e:offline": "playwright test --config playwright.offline.config.ts",
    "test:full-offline": "node --import tsx --test src/lib/offline-engine.test.ts src/lib/local-api.test.ts src/lib/db-migration.test.ts src/lib/offline-prefetch.test.ts src/lib/offline-login.test.ts src/lib/queued-credentials.test.ts src/lib/security-session.test.ts src/lib/local-encryption.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:offline": "node --test src/lib/service-worker.test.mjs src/lib/pdf-download.test.mjs src/lib/student-route-policy.test.mjs src/lib/offline/attendance-validation.test.mjs src/lib/offline/retry-policy.test.mjs && node --import tsx --test src/lib/offline/outbox-sync.test.ts src/lib/offline/feed-replica.test.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mobile:sync": "node scripts/capacitor-cli.mjs sync",
    "mobile:android": "node scripts/capacitor-cli.mjs open android",
    "mobile:ios": "node scripts/capacitor-cli.mjs open ios",
    "mobile:add:android": "node scripts/capacitor-cli.mjs add android",
    "mobile:add:ios": "node scripts/capacitor-cli.mjs add ios",
    "test:e2e": "playwright test",
    "test:local-security": "node --import ./scripts/register-test-loader.mjs --test src/lib/app-lock.test.ts src/lib/back-navigation.test.ts src/lib/communication-offline.test.ts src/lib/offline-access-policy.test.ts src/lib/notification-audio.test.mjs src/lib/pending-avatar.test.ts src/lib/read-refresh.test.ts src/lib/pending-student-photos.test.ts src/lib/audio-logo-samples.test.mjs src/lib/local-support.test.ts src/lib/local-conversations.test.ts",
    "review:mobile": "node scripts/review-mobile.mjs",
    "test:notification-sounds": "node --import ./scripts/register-test-loader.mjs --test src/lib/exclusive-audio-preview.test.ts src/lib/notification-sound-policy.test.ts src/lib/notification-sound-storage.test.ts src/lib/notification-audio.test.mjs",
    "test:sound-channels": "node scripts/test-sound-channels.mjs",
    "review:notification-sounds": "node scripts/review-notification-sounds.mjs",
    "generate:notification-sounds": "node scripts/generate-notification-sounds.mjs",
    "generate:audio-logo-samples": "node scripts/generate-audio-logo-samples.mjs",
    "review:theme": "node --import ./scripts/register-test-loader.mjs scripts/review-theme-transition.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "6.0.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@fontsource/tajawal": "^5.3.0",
    "@tanstack/react-query": "^5.62.7",
    "adhan": "^4.4.3",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.6",
    "idb": "^8.0.4",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.14.1",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "1.0.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.4"
  },
  "overrides": {
    "tar": "^7.5.21"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
