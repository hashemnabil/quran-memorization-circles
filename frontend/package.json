    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.14.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
